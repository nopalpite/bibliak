# Copy this file to ".env" and adjust the values if needed.

SECRET_KEY=change-me-in-production
DATABASE_PATH=instance/biblio.sqlite3

# Priority source for ISBN metadata retrieval: openlibrary | googlebooks
PRIORITY_API=openlibrary

# Optional: Google Books API key (increases quotas, not required)
GOOGLE_BOOKS_API_KEY=

# Recommended: an email or phone number, sent in the User-Agent header of
# calls to Open Library / Google Books. Open Library uses it to contact you
# in case of high request volume, and grants in exchange a 3x more generous
# rate limit (3 requests/second instead of 1).
# Example: CONTACT_INFO=you@example.com
CONTACT_INFO=

# Local IP address of the machine hosting the app (e.g. 192.168.1.20).
# Needed for the self-signed HTTPS certificate to be valid for this address,
# and for camera scanning to work from a smartphone on the network.
# Without this value, only https://localhost:8000 will be recognized by the certificate.
HOST_IP=

# true (default): the container generates/serves its own self-signed HTTPS certificate.
# false: TLS is terminated upstream (reverse proxy); the container serves the app in plain HTTP.
HTTPS_AUTOSIGNE=true
