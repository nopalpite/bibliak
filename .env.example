# Copier ce fichier en ".env" et adapter les valeurs si besoin.

SECRET_KEY=change-moi-en-production
DATABASE_PATH=instance/biblio.sqlite3

# Source prioritaire pour la récupération des métadonnées ISBN : openlibrary | googlebooks
API_PRIORITAIRE=openlibrary

# Optionnel : clé API Google Books (augmente les quotas, non obligatoire)
GOOGLE_BOOKS_API_KEY=

# Recommandé : un email ou numéro de contact, envoyé dans l'en-tête User-Agent
# des appels à Open Library / Google Books. Open Library l'utilise pour vous
# contacter en cas de volume de requêtes élevé, et accorde en échange une
# limite de débit 3x plus généreuse (3 requêtes/seconde au lieu d'1).
# Exemple : CONTACT_INFO=vous@example.com
CONTACT_INFO=

# Adresse IP locale de la machine qui héberge l'application (ex: 192.168.1.20).
# Nécessaire pour que le certificat HTTPS auto-signé soit valide pour cette
# adresse et que le scan caméra fonctionne depuis un smartphone du réseau.
# Sans cette valeur, seul https://localhost:8000 sera reconnu par le certificat.
HOST_IP=

# true (défaut) : le conteneur génère/sert lui-même son certificat HTTPS auto-signé.
# false : TLS est terminé en amont (reverse proxy) ; le conteneur sert l'app en HTTP simple.
HTTPS_AUTOSIGNE=true
